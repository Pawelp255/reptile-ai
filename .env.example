VITE_SUPABASE_PROJECT_ID="mkgdgxsrykwmopokvxlx"
# Dev only: optional override. Production builds ignore this and use https://mkgdgxsrykwmopokvxlx.supabase.co (see src/integrations/supabase/env.ts).
VITE_SUPABASE_URL="https://mkgdgxsrykwmopokvxlx.supabase.co"
# Must be the publishable/anon key for project mkgdgxsrykwmopokvxlx (Dashboard → Project Settings → API).
VITE_SUPABASE_PUBLISHABLE_KEY="your-supabase-anon-or-publishable-key"

# App Store / TestFlight archive: set ONE of these to "true" to hide Pro, upgrade, billing, and AI assistant UI.
# VITE_APPSTORE_REVIEW_MODE=true
# VITE_DISABLE_PRO=true

# Android native builds use the same Vite env as iOS. Required for auth/sync:
# VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-or-publishable-key
# Build with: npm run build:android (disables PWA service worker for WebView)
# Play review build (opt-in): npm run build:android:playstore
